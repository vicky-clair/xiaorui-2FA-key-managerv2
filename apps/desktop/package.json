{
  "name": "@sa/desktop",
  "version": "1.0.0",
  "description": "Xiaorui 2FA Security Vault Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "bun --cwd ../expo expo export --platform web",
    "build": "electron-builder build --win --dir",
    "build:exe": "electron-builder build --win nsis portable",
    "build:msix": "electron-builder build --win appx"
  },
  "build": {
    "appId": "com.xiaorui.secureauthenticator",
    "productName": "Xiaorui 2FA Security Vault",
    "directories": {
      "output": "release"
    },
    "files": ["main.js", "package.json", "../expo/dist/**/*"],
    "extraResources": [
      {
        "from": "../expo/dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": ["nsis", "portable", "appx"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xiaorui 2FA Security Vault"
    },
    "appx": {
      "identityName": "Xiaorui2FASecurityVault",
      "publisher": "CN=Xiaorui",
      "publisherDisplayName": "Xiaorui 2FA Security Vault",
      "showNameOnTiles": true
    }
  },
  "devDependencies": {
    "electron": "^39.8.1",
    "electron-builder": "^26.15.0",
    "electron-builder-squirrel-windows": "^26.15.3"
  }
}
